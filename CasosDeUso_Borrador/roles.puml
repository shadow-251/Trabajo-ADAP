@startuml
title Casos de uso - Usuarios y roles
left to right direction

actor Administrador
actor Superadministrador
Administrador <|-- Superadministrador

rectangle "Usuarios y roles" {
  usecase "Dar de alta usuarios" as usuarios
  usecase "Asignar clientes a un lector" as asignar
  usecase "Ver dashboard" as dashboard
  usecase "Configurar sistema" as config
  usecase "Ver registro de actividad" as registro
}

Administrador --> usuarios
Administrador --> asignar
Administrador --> dashboard
Superadministrador --> config
Superadministrador --> registro
@enduml
