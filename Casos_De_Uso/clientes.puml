@startuml
title Casos de uso - Registro de clientes
left to right direction

actor Lector
actor Administrador
Lector <|-- Administrador

rectangle "Registro de clientes" {
  usecase "Dar de alta cliente" as alta
  usecase "Modificar cliente" as modificar
  usecase "Buscar cliente" as buscar
  usecase "Cambiar estado del cliente" as estado
  usecase "Dar de baja cliente" as baja
  usecase "Comprobar facturas impagadas" as impagadas
  usecase "Importar clientes por CSV" as csv
}

Lector --> alta
Lector --> modificar
Lector --> buscar
Lector --> estado
Lector --> baja
Administrador --> csv

baja ..> impagadas : <<include>>
@enduml
