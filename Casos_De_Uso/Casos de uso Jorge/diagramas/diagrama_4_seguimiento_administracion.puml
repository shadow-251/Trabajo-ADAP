actor "Administrador" as ADM
actor "Superadministrador" as SA

ADM --|> UO
SA --|> ADM

rectangle "Sistema de facturación y cobros" {
  usecase "CU-17\nIniciar sesión" as CU17
  usecase "CU-18\nConsultar trabajo\npendiente" as CU18
  usecase "CU-19\nConsultar informes" as CU19
  usecase "CU-20\nConsultar dashboard\nfinanciero" as CU20
  usecase "CU-21\nGestionar usuarios" as CU21
  usecase "CU-22\nAsignar clientes" as CU22
  usecase "CU-23\nConfigurar sistema" as CU23
  usecase "CU-24\nConsultar auditoría" as CU24
}

UO -- CU17
UO -- CU18
UO -- CU19
ADM -- CU20
ADM -- CU21
ADM -- CU22
SA -- CU23
SA -- CU24

@enduml
