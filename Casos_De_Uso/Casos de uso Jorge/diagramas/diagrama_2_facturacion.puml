@startuml diagrama_2_facturacion
title Casos de uso · 2/4 · Facturación

left to right direction

actor "Usuario operativo" as UO
actor "Temporizador" as TMP
actor "Administrador" as ADM
actor "Servicio de mensajería\n(email, WhatsApp simulado)" as MSG

ADM --|> UO

rectangle "Sistema de facturación y cobros" {
  usecase "CU-07\nGenerar facturas\nrecurrentes" as CU07
  usecase "CU-08\nCrear factura puntual" as CU08
  usecase "CU-09\nEmitir factura" as CU09
  usecase "CU-10\nEmitir factura\nrectificativa" as CU10
  usecase "CU-12\nResolver solicitud\nde aprobación" as CU12
  usecase "CU-16\nGestionar incidencia\nde facturación\n(diagrama 3)" as CU16
  usecase "CU-11\nSolicitar aprobación" as CU11
}

TMP -- CU07
UO -- CU08
ADM -- CU10
ADM -- CU12
CU09 -- MSG

CU07 ..> CU09 : <<include>>
CU08 ..> CU09 : <<include>>
CU10 ..> CU09 : <<include>>

CU09 ..> CU16 : <<extend>>
CU09 ..> CU11 : <<extend>>

@enduml
