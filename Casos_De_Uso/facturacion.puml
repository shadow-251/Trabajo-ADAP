@startuml
title Casos de uso - Facturación
left to right direction

actor Lector

rectangle "Facturación" {
  usecase "Hacer factura puntual" as puntual
  usecase "Hacer factura recurrente" as recurrente
  usecase "Modificar factura" as modificar
  usecase "Consultar facturas" as consultar
  usecase "Descargar factura" as descargar
  usecase "Enviar factura al cliente" as enviar
}

Lector --> puntual
Lector --> recurrente
Lector --> modificar
Lector --> consultar
Lector --> descargar

puntual ..> enviar : <<include>>
recurrente ..> enviar : <<include>>
@enduml
