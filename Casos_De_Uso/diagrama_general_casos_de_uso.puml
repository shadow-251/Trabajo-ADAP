@startuml diagrama_general_casos_de_uso
title Visión general

left to right direction

actor "Pasarela de cobro\n(Stripe simulado)" as PAS
actor "Usuario operativo" as UO
actor "Sistema externo\n(Brain, vía API)" as EXT
actor "Servicio de mensajería\n(email)" as MSG
actor "Administrador" as ADM
actor "Temporizador" as TMP
actor "Superadministrador" as SA

ADM --|> UO
SA --|> ADM

rectangle "Sistema de facturación y cobros" {
  package "Clientes y relación comercial" {
    usecase "CU-01 Gestionar cliente" as CU01
    usecase "CU-03 Gestionar suscripción" as CU03
    usecase "CU-06 Tramitar baja" as CU06
  }
  package "Facturación" {
    usecase "CU-12 Resolver solicitud de aprobación" as CU12
    usecase "CU-07 Generar facturas recurrentes" as CU07
    usecase "CU-09 Emitir factura" as CU09
    usecase "CU-08 Crear factura puntual" as CU08
  }
  package "Cobros" {
    usecase "CU-14 Enviar recordatorios de cobro" as CU14
    usecase "CU-13 Registrar cobro" as CU13
  }
  package "Acceso, seguimiento y administración" {
    usecase "CU-21 Gestionar usuarios" as CU21
    usecase "CU-20 Consultar dashboard financiero" as CU20
    usecase "CU-23 Configurar sistema" as CU23
  }
}

ADM --> CU20
ADM --> CU21
UO --> CU08
SA --> CU23
ADM --> CU12
CU07 <-- TMP
UO --> CU03
CU13 <-- PAS
UO --> CU01
CU09 <-- MSG
CU06 <-- EXT
UO --> CU06
CU14 <-- TMP

@enduml
